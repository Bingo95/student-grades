{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "allowJs": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./src/.umi/*"],
      "@config/*": ["./config/*"],
      "@@test/*": ["./src/.umi-test/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/umi/types" // 显式指定 umi 类型路径
    ]
  },
  "include": ["./**/*.d.ts", "./**/*.ts", "./**/*.tsx", "config.ts"],
  "exclude": ["node_modules"]
}
